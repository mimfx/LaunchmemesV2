# Server-only. Keep real values in Render Environment settings, never commit them.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SOLANA_MAINNET_RPC_URL=https://YOUR-MAINNET-RPC-ENDPOINT
PINATA_JWT=
X_BEARER_TOKEN=

# Public browser value. It must point to Solana Mainnet-Beta and contains no secret.
VITE_SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
